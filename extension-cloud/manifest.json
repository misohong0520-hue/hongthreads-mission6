{
  "manifest_version": 3,
  "name": "HongThreads Scraper",
  "version": "1.136.0.2",
  "description": "HongThreads의 개인 Supabase 보관함에 Threads 자료를 저장합니다.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.threads.com/*",
    "https://*.threads.net/*",
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*",
    "https://*.amazonaws.com/*",
    "https://*.r2.cloudflarestorage.com/*",
    "https://cdn.agczero.com/*",
    "https://hongthreads.hongsik.blog/*"
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": "icon.png",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.threads.com/*",
        "https://*.threads.net/*"
      ],
      "js": [
        "content.js",
        "local-post-bridge.js"
      ]
    },
    {
      "matches": [
        "https://hongthreads.hongsik.blog/*"
      ],
      "js": [
        "local-app-bridge.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "interceptor.js",
        "icon.png",
        "logo_white.png"
      ],
      "matches": [
        "https://*.threads.net/*",
        "https://*.threads.com/*"
      ]
    }
  ]
}
